{% extends "base.html.j2" %}
{% block main %}
<div class="docs">
  <aside class="sidebar" aria-label="Documentation">
    {% for group, pages in nav %}
    <h4>{{ group }}</h4>
    {% for p in pages %}<a href="{{ root }}docs/{{ p.slug ~ "/" if p.slug else "" }}"{% if p.slug == page.slug %} aria-current="page"{% endif %}>{{ p.title }}</a>{% endfor %}
    {% endfor %}
  </aside>
  <article class="prose">
    {{ page.html|safe }}
    <nav class="pager" aria-label="Pagination">
      {% if prev %}<a href="{{ root }}docs/{{ prev.slug ~ "/" if prev.slug else "" }}"><span>Previous</span>{{ prev.title }}</a>{% endif %}
      {% if next %}<a class="next" href="{{ root }}docs/{{ next.slug ~ "/" if next.slug else "" }}"><span>Next</span>{{ next.title }}</a>{% endif %}
    </nav>
  </article>
  <aside class="toc" aria-label="On this page">{% if page.toc %}<h4>On this page</h4>{{ page.toc|safe }}{% endif %}</aside>
</div>
{% endblock %}
