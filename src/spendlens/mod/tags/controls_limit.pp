  description = "Check if the number of tags on RDS DB subnet groups is within the limit."
  severity    = "low"
  sql         = replace(local.tags_limit_sql, "__TABLE_NAME__", "aws_rds_db_subnet_group")
  tags = {
    spendlens_check = "tags_limit"
    resource_type   = "rds_db_subnet_group"
  }
  param "tag_limit" {
    default = var.tag_limit
  }
}

