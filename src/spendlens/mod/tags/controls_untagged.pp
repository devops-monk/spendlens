  description = "Check if SSM parameters have at least 1 tag."
  severity    = "medium"
  sql         = replace(local.tags_untagged_sql, "__TABLE_NAME__", "aws_ssm_parameter")
  tags = {
    spendlens_check = "tags_untagged"
    resource_type   = "ssm_parameter"
  }
}

