{#- Page shell for every spendlens HTML output. Self-contained: CSS/JS are inlined, no network requests.
    Context: title, subtitle, theme (DashboardConfig), tabs [(id, name)] | none, footer, data_json | none -#}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="generator" content="spendlens"><title>{{ title }}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='sf-bg' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%230a84ff'%2F%3E%3Cstop offset='.55' stop-color='%237d5cff'%2F%3E%3Cstop offset='1' stop-color='%23ff375f'%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect width='64' height='64' rx='14.5' fill='url%28%23sf-bg%29'%2F%3E%3Ccircle cx='27' cy='27' r='15' fill='%23fff' fill-opacity='.16' stroke='%23fff' stroke-width='7'%2F%3E%3Crect x='18.5' y='19' width='7' height='16' rx='2' fill='%23fff'%2F%3E%3Crect x='28.5' y='26' width='7' height='9' rx='2' fill='%23fff'%2F%3E%3Cpath d='M39.5 39.5 51 51' stroke='%23fff' stroke-width='9.5' stroke-linecap='round'%2F%3E%3C%2Fsvg%3E">
{#- CSS context: HTML-escaping would corrupt quotes in the font stack. These values are pattern-validated in
    config.DashboardConfig (#RRGGBB colours; font stack without < > ; { }), so they are safe to emit raw. -#}
<style>:root{--brand:{{ theme.brand_primary|safe }};--brand-ink:{{ theme.brand_ink|safe }};--brand-on-ink:{{ theme.brand_on_ink|safe }};--font:{{ theme.font_family|safe }}}
{{ assets.css }}</style></head>
<body>
<header class="top"><div class="row"><div><h1>{{ title }}</h1>
<div class="sub">{{ subtitle }}{% if theme.organisation %} · {{ theme.organisation }}{% endif %}</div></div>
<button class="theme" type="button">Light / dark</button></div></header>
{%- if tabs %}
<nav class="tabs" role="tablist">{% for id, name in tabs %}<button role="tab" data-tab="{{ id }}" aria-selected="false">{{ name }}</button>{% endfor %}</nav>
{%- endif %}
<main>{% block main %}{% endblock %}</main>
<footer>{{ footer }}</footer>
<div id="tip" role="tooltip"></div>
{%- if data_json %}
<script type="application/json" id="spendlens-data">{{ data_json }}</script>
{%- endif %}
<script>{{ assets.js }}</script>
</body></html>
