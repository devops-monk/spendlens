{#- `spendlens graph show -o x.html` (one resource and its neighbours) and `spendlens graph orphans -f html`
    (cleanup groups). Context: vm (features/graph_cmd.py). SVGs are built by spendlens.graph.render with every
    name escaped, so they are emitted as markup. -#}
{% extends "base.html.j2" %}
{% block main %}
{% if vm.age %}{% set a = vm.age %}
<section class="br-section">
  <div class="br-kpis">
    <div class="br-kpi tone-warn"><div class="k">Cost of these resources</div><div class="v">{{ a.total }}</div><div class="d">per month, {{ a.count }} resource{{ "s" if a.count != 1 }}</div></div>
    {% for b in a.buckets %}<div class="br-kpi"><div class="k">{{ b.age }}</div><div class="v">{{ b.count }}</div><div class="d">${{ "{:,.2f}".format(b.monthly_cost) }}/month</div></div>{% endfor %}
  </div>
  {% if a.bars %}<div class="card"><h2>Monthly cost by age</h2><p class="hint">What resources of each age cost; old and costly is worth a look.</p>{{ charts.hbars(a.bars, label="Monthly cost by age", fill="var(--series-4)", width=1080) }}</div>{% endif %}
  <div class="grid2">
    <div class="card"><h2>By type</h2><div class="tablewrap"><table><thead><tr><th>Type</th><th class="num">Resources</th><th class="num">Cost/month</th><th class="num">Oldest</th></tr></thead><tbody>
    {% for t in a.by_type %}<tr><td>{{ t.type }}</td><td class="num">{{ t.count }}</td><td class="num">${{ "{:,.2f}".format(t.monthly_cost) }}</td><td class="num">{{ t.oldest_days }} days</td></tr>{% endfor %}
    </tbody></table></div></div>
    <div class="card"><h2>How ages are read</h2><p class="hint">From each resource's own date: creation, launch or snapshot time. Lambda functions: since their last change; network interfaces: since attached (no creation date in the API). {{ a.undated }} resource(s) have no date.</p></div>
  </div>
  <div class="card"><h2>The costliest</h2>
    <div class="tablewrap"><table class="sortable"><thead><tr><th>Resource</th><th>Type</th><th>Age</th><th>Created</th><th class="num">Cost/month</th><th>Owner</th><th>Cleanup group</th></tr></thead><tbody>
    {% for r in a.rows %}<tr><td>{{ r.name }}</td><td>{{ r.type }}</td><td data-v="{{ r.age_days }}">{{ r.age }}</td><td>{{ r.created }}</td><td class="num" data-v="{{ r.monthly_cost }}">${{ "{:,.2f}".format(r.monthly_cost) }}</td><td>{{ r.owner }}</td><td>{{ r.cleanup_group }}</td></tr>{% endfor %}
    </tbody></table></div></div>
</section>
{% endif %}
{% if vm.traffic %}{% set t = vm.traffic %}
<section class="br-section">
  <div class="br-kpis">
    <div class="br-kpi tone-warn"><div class="k">Data transfer</div><div class="v">{{ t.total }}</div><div class="d">per month, priced paths only</div></div>
    {% for k, v in t.by_path.items() %}<div class="br-kpi"><div class="k">{{ v.label }}</div><div class="v">{{ "{:,.0f}".format(v.gb_month) }} GB</div><div class="d">${{ "{:,.2f}".format(v.monthly_cost) }}/month</div></div>{% endfor %}
  </div>
  {% for p in t.proposals %}
  <article class="card gr-card">
    <div class="gr-head"><div><span class="gr-kind">Proposal</span><h2>{{ p.title }}</h2></div>
      <div class="gr-amt">${{ "{:,.2f}".format(p.monthly_saving) }}<span>/month</span></div></div>
    <p>{{ p.why }}</p><dl class="gr-dl"><dt>Before you do</dt><dd>{{ p.check_first }}</dd></dl>
  </article>
  {% endfor %}
  {% if t.svg %}<div class="card"><h2>Costliest paths</h2><p class="hint">Each line: GB per month and its monthly cost, through the NAT gateway where there is one.</p><div class="gw">{{ t.svg }}</div></div>{% endif %}
  <div class="card"><h2>Every path</h2>
    <p class="hint">Monthly rates from the last {{ t.window_days }} days of VPC flow logs; prices from finops.yaml (pricing.*_gb). Traffic between two collected resources is counted once, by the sender.</p>
    <div class="tablewrap"><table class="sortable"><thead><tr><th>Resource</th><th>Path</th><th>To</th><th>Via</th><th class="num">GB in</th><th class="num">GB out</th><th class="num">Cost</th></tr></thead><tbody>
    {% for r in t.rows %}<tr><td>{{ r.resource_name }}</td><td>{{ r.path_label }}</td><td>{{ r.peer_name }}</td><td>{{ r.via_name }}</td><td class="num">{{ "{:,.0f}".format(r.gb_in_month) }}</td><td class="num">{{ "{:,.0f}".format(r.gb_out_month) }}</td><td class="num" data-v="{{ r.monthly_cost }}">${{ "{:,.2f}".format(r.monthly_cost) }}</td></tr>{% endfor %}
    </tbody></table></div></div>
</section>
{% endif %}
{% if vm.focus %}
<section class="br-section">
  <div class="br-kpis">
    <div class="br-kpi"><div class="k">Resource</div><div class="v gr-v">{{ vm.focus.label }}</div><div class="d">{{ vm.focus.type }}</div></div>
    <div class="br-kpi"><div class="k">Its own cost</div><div class="v">{{ vm.focus.cost or "–" }}</div><div class="d">{{ vm.focus.basis or "estimate" }}, per month</div></div>
    <div class="br-kpi"><div class="k">With everything shown</div><div class="v">{{ vm.total }}</div><div class="d">{{ vm.count }} resources within {{ vm.depth }} link{{ "s" if vm.depth != 1 }}</div></div>
    <div class="br-kpi tone-{{ 'warn' if vm.groups else 'good' }}"><div class="k">In cleanup groups</div><div class="v">{{ vm.groups|length }}</div><div class="d">{{ vm.groups_saving }}/month to review</div></div>
  </div>
  <div class="card">
    <h2>How {{ vm.focus.label }} connects</h2>
    <p class="hint">Hover a resource to see its links. Orange: in a cleanup group · red: a failing check · dashed line: a reference (each side lives on without the other).</p>
    <div class="gw">{{ vm.svg }}</div>
  </div>
</section>
{% endif %}

{% if vm.groups %}
<section class="br-section" id="groups">
  {% if vm.focus %}<h2 class="br-h">Cleanup groups here</h2>{% endif %}
  {% if not vm.focus %}
  <div class="br-kpis">
    <div class="br-kpi tone-warn"><div class="k">Potential saving</div><div class="v">{{ vm.groups_saving }}</div><div class="d">per month, {{ vm.groups|length }} group{{ "s" if vm.groups|length != 1 }}</div></div>
    <div class="br-kpi"><div class="k">Resources</div><div class="v">{{ vm.members }}</div><div class="d">that can be removed together</div></div>
    <div class="br-kpi"><div class="k">Already flagged by waste</div><div class="v">{{ vm.flagged }}</div><div class="d">of the saving; the rest is new</div></div>
  </div>
  {% endif %}
  {% for g in vm.groups %}
  <article class="card gr-card">
    <div class="gr-head"><div><span class="gr-kind">{{ g.kind_label }}</span><h2>{{ g.title }}</h2></div>
      <div class="gr-amt">{{ g.saving }}<span>/month</span></div></div>
    <ul class="gr-ev">{% for e in g.evidence %}<li>{{ e }}</li>{% endfor %}</ul>
    {% if g.svg %}<div class="gw mini">{{ g.svg }}</div>{% endif %}
    <dl class="gr-dl"><dt>Action</dt><dd>{{ g.action }}</dd><dt>Before you do</dt><dd>{{ g.risk }}</dd>
      {% if g.owner %}<dt>Owner</dt><dd>{{ g.owner }}</dd>{% endif %}
      {% if g.findings %}<dt>Waste checks</dt><dd>{{ g.findings|length }} of these resources are already flagged ({{ g.findings_saving }}/month).</dd>{% endif %}</dl>
    <details><summary>{{ g.rows|length }} resource{{ "s" if g.rows|length != 1 }}</summary>
      <div class="tablewrap"><table><thead><tr><th>Type</th><th>Name</th><th>State</th><th class="num">Cost</th><th>ID</th></tr></thead><tbody>
      {% for r in g.rows %}<tr><td>{{ r.type }}</td><td>{{ r.name }}</td><td>{{ r.state }}</td><td class="num">{{ r.cost }}</td><td><code>{{ r.id }}</code></td></tr>{% endfor %}
      </tbody></table></div></details>
  </article>
  {% endfor %}
  <p class="note">Costs are estimates from the finops.yaml price book (snapshot costs are an upper bound). Each resource is in at most one group. spendlens never deletes anything: review each group with its owner.</p>
</section>
{% elif not vm.focus and not vm.traffic and not vm.age %}
<section class="br-section"><div class="card"><h2>No cleanup groups</h2><p class="empty">Nothing found that can be removed together. Thresholds: <code>graph.*</code> in finops.yaml.</p></div></section>
{% endif %}

{% if vm.shared %}
<section class="br-section">
  <div class="card"><h2>Shared costs</h2>
    <p class="hint">A NAT gateway's hourly charge split equally across the subnets that route through it, and a load balancer's across its target groups. An allocation estimate, not a measured figure; data processing is extra.</p>
    <div class="tablewrap"><table><thead><tr><th>Shared resource</th><th>Used by</th><th class="num">Share</th><th>Basis</th></tr></thead><tbody>
    {% for x in vm.shared %}<tr><td>{{ x.source_name }}</td><td>{{ x.target_name }}</td><td class="num">{{ x.amount_s }}</td><td>{{ x.basis }}</td></tr>{% endfor %}
    </tbody></table></div></div>
</section>
{% endif %}
{% if vm.rows %}
<section class="br-section">
  <div class="card"><h2>Resources shown</h2>
    <div class="tablewrap"><table class="sortable"><thead><tr><th>Type</th><th>Name</th><th>State</th><th class="num">Cost</th><th>Basis</th><th>Region</th><th>ID</th></tr></thead><tbody>
    {% for r in vm.rows %}<tr><td>{{ r.type }}</td><td>{{ r.name }}</td><td>{{ r.state }}</td><td class="num" data-v="{{ r.amount }}">{{ r.cost }}</td><td>{{ r.basis }}</td><td>{{ r.region }}</td><td><code>{{ r.id }}</code></td></tr>{% endfor %}
    </tbody></table></div></div>
</section>
{% endif %}
{% for n in vm.notes %}<p class="note">· {{ n }}</p>{% endfor %}
{% endblock %}
